---
import '../styles/ai-section.css';
import { Image } from 'astro:assets';
import felixFox from '../assets/images/felix fox.jpg';
---

<section class="ai-section" id="fullfill-ai">
  <div class="landing-container ai-section__layout">

    <!-- Left: Text content -->
    <div class="ai-section__content ai-animate-left">
      <h2 class="ai-section__title">ask felix how to be happier</h2>
      <p class="ai-section__desc">trained on psychology and the journeys of top performers — invaluable insights improve your life</p>
    </div>

    <a href="#" class="btn-primary ai-section__chat-cta">chat now</a>

    <!-- Right: Book image -->
    <div class="ai-section__image ai-animate-right">
      <Image src={felixFox} alt="Felix the fox, your Fullfill mind coach" class="ai-section__book-img" />
    </div>

  </div>
</section>


<script>
  const section = document.querySelector('#fullfill-ai');
  const layout = document.querySelector('.ai-section__layout');

  if (section && layout) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            layout.classList.add('ai-in');
            section.classList.add('ai-in');
          } else {
            const els = layout.querySelectorAll('.ai-animate-left, .ai-animate-right');
            const chat = section.querySelector('.ai-section__chat-cta');
            if (chat) chat.style.transition = 'none';
            els.forEach(el => (el.style.transition = 'none'));
            layout.classList.remove('ai-in');
            section.classList.remove('ai-in');
            requestAnimationFrame(() =>
              requestAnimationFrame(() => {
                els.forEach(el => (el.style.transition = ''));
                if (chat) chat.style.transition = '';
              })
            );
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(section);
  }
</script>
