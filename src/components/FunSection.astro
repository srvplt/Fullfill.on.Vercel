---
import '../styles/fun-section.css';
import { getImage } from 'astro:assets';

import cardBreathwork from '../assets/images/banner/unsplash-1545389336.jpg';
import cardFocusFlow  from '../assets/images/banner/unsplash-focus-flow.jpg';
import cardStretch    from '../assets/images/banner/unsplash-1518611012118.jpg';
import cardSleepYoga  from '../assets/images/banner/unsplash-1419242902214.jpg';
import cardVinyasa    from '../assets/images/banner/unsplash-1544367567.jpg';

const card1   = await getImage({ src: cardBreathwork, format: 'webp', width: 600 });
const card2   = await getImage({ src: cardFocusFlow,  format: 'webp', width: 600 });
const card3   = await getImage({ src: cardStretch,    format: 'webp', width: 600 });
const card4   = await getImage({ src: cardSleepYoga,  format: 'webp', width: 600 });
const card5   = await getImage({ src: cardVinyasa,    format: 'webp', width: 600 });
---

<section class="fun-section" id="sec-habit-feed">
  <div class="hf-overlay"></div>

  <div class="hf-container landing-container">

    <!-- Left: Phone with cycling cards -->
    <div class="hf-phone-area">
      <div class="hf-phone-frame">
        <div class="hf-video-card active"
          style={`background-image: linear-gradient(transparent, rgba(0,0,0,0.8)), url('${card1.src}')`}>
          <p>daily breathwork</p>
        </div>
        <div class="hf-video-card"
          style={`background-image: linear-gradient(transparent, rgba(0,0,0,0.8)), url('${card2.src}')`}>
          <p>focus flow</p>
        </div>
        <div class="hf-video-card"
          style={`background-image: linear-gradient(transparent, rgba(0,0,0,0.8)), url('${card3.src}')`}>
          <p>morning stretch</p>
        </div>
        <div class="hf-video-card"
          style={`background-image: linear-gradient(transparent, rgba(0,0,0,0.8)), url('${card4.src}')`}>
          <p>deep sleep yoga</p>
        </div>
        <div class="hf-video-card"
          style={`background-image: linear-gradient(transparent, rgba(0,0,0,0.8)), url('${card5.src}')`}>
          <p>mindful vinyasa</p>
        </div>
      </div>
    </div>

    <!-- Right: Text + CTA -->
    <div class="hf-text-area">
      <div class="hf-heading-group">
        <h2 class="hf-heading"><span class="hf-grad">Fullfill is <span class="accent">fun.</span></span></h2>
        <p class="hf-text">Engaging content brings you back, reinforcing positive habit-loops for lasting wellness.</p>
      </div>
    </div>

  </div>
</section>

<script>
  (function () {
    const cards = document.querySelectorAll('.hf-video-card');
    let idx = 0;

    function cycle() {
      cards[idx].classList.remove('active');
      cards[idx].classList.add('prev');
      idx = (idx + 1) % cards.length;
      cards[idx].classList.remove('prev');
      cards[idx].classList.add('active');
    }

    let timer;
    const section = document.querySelector('#sec-habit-feed');

    if ('IntersectionObserver' in window && section) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            timer = setInterval(cycle, 3000);
          } else {
            clearInterval(timer);
          }
        });
      }, { threshold: 0.3 });
      obs.observe(section);
    } else {
      timer = setInterval(cycle, 3000);
    }
  })();
</script>
