---
import "../styles/footer.css";
import { Image } from "astro:assets";
import logo from "../assets/images/FinalLogoNameOnly.png";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__copyright">
        <p>
          © {currentYear} Fullfill |
          <a href="https://fullfill.me/privacy">Privacy Policy</a> |
          <a href="https://fullfill.me/terms">Terms</a>
        </p>
      </div>

      <div class="site-footer__logo">
        <a href="/" aria-label="Fullfill home">
          <Image src={logo} alt="Fullfill" width={logo.width} height={logo.height} />
        </a>
      </div>

      <div class="site-footer__social">
        <a
          href="https://www.facebook.com/share/1HCWzt8tce"
          title="facebook"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="none" role="img" aria-label="Facebook" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5" />
            <path d="M13.7 19v-6.4h2.15l.32-2.5H13.7V8.5c0-.72.2-1.22 1.25-1.22h1.34V5.05c-.23-.03-1.03-.1-1.96-.1-1.94 0-3.27 1.18-3.27 3.36v1.79H8.87v2.5h2.19V19h2.64Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href="https://www.instagram.com/fullfill.me"
          title="instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="none" role="img" aria-label="Instagram" xmlns="http://www.w3.org/2000/svg">
            <rect x="3.25" y="3.25" width="17.5" height="17.5" rx="5.2" stroke="currentColor" stroke-width="1.5" />
            <circle cx="12" cy="12" r="4.05" stroke="currentColor" stroke-width="1.5" />
            <circle cx="17.55" cy="6.7" r="1" fill="currentColor" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
