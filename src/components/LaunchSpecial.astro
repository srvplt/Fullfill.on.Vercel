---
import '../styles/launch-special.css';
---

<section class="ls-section" id="sec-launch-special" aria-labelledby="ls-heading">
  <h2 class="ls-visually-hidden" id="ls-heading">Fullfill <span class="accent">in action</span></h2>
  <div class="ls-video-frame" id="ls-video-frame"></div>
</section>

<script>
  const frame = document.querySelector('#ls-video-frame');
  if (frame) {
    const mobileQuery = window.matchMedia('(max-width: 767px)');
    const renderVideo = () => {
      const isMobile = mobileQuery.matches;
      const videoId = isMobile ? 'InRmhsLv2NQ' : 'HCBZhlPYVIM';
      const title = isMobile ? 'Fullfill mobile app video' : 'Fullfill desktop app video';
      const current = frame.querySelector('iframe');
      if (current?.dataset.videoId === videoId) return;

      const iframe = document.createElement('iframe');
      iframe.className = 'ls-video';
      iframe.dataset.videoId = videoId;
      const params = new URLSearchParams({
        autoplay: '1',
        mute: '1',
        playsinline: '1',
        controls: '1',
        rel: '0',
        loop: '1',
        playlist: videoId,
      });
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?${params.toString()}`;
      iframe.title = title;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
    };

    renderVideo();
    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener('change', renderVideo);
    } else {
      mobileQuery.addListener(renderVideo);
    }
  }
</script>
