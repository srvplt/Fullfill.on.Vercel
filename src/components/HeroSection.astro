---
import '../styles/hero.css';
import { Image } from 'astro:assets';
import logoNameOnly from '../assets/images/FinalLogoNameOnly.png';
import finalImg from '../assets/images/final.png';
---

<section class="hero" id="hero">
  <svg class="hero__glow-wave" viewBox="0 0 1440 180" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="heroGlowGradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#8DEBFF" stop-opacity="0" />
        <stop offset="25%" stop-color="#8DEBFF" stop-opacity=".8" />
        <stop offset="55%" stop-color="#FFFFFF" stop-opacity="1" />
        <stop offset="80%" stop-color="#B9A7FF" stop-opacity=".85" />
        <stop offset="100%" stop-color="#B9A7FF" stop-opacity="0" />
      </linearGradient>
      <filter id="heroGlowBlur" x="-20%" y="-100%" width="140%" height="300%">
        <feGaussianBlur stdDeviation="4" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
    <path class="hero__glow-wave-line" d="M-30 105 C 160 30, 260 155, 455 95 S 755 35, 930 90 S 1230 145, 1470 55" />
  </svg>
  <div class="landing-container hero__inner">
    <div class="hero__phone">
      <video id="hp-video-comp" autoplay loop muted playsinline class="hero__phone-video">
        <source src="/images/final.mov" type='video/quicktime; codecs="ap4h"'>
        <source src="/images/final.webm" type="video/webm">
      </video>
      <Image id="fallback-img-comp" src={finalImg} alt="Fullfill App" class="hero__phone-video" width={390} height={844} loading="eager" style="display: none;" />
      <script is:inline>
        (function() {
          const video = document.getElementById('hp-video-comp');
          const img = document.getElementById('fallback-img-comp');
          if (video && img) {
            const userAgent = navigator.userAgent;
            const isAppleMobile = /iPhone|iPad|iPod/i.test(userAgent);
            let activeEl;
            if (isAppleMobile) {
              const iOSVersion = parseInt(userAgent.match(/iPhone OS (\d+)_/)?.[1] || 0);
              activeEl = (iOSVersion >= 16) ? video : img;
            } else {
              activeEl = video;
            }
            activeEl.style.display = 'block';
            if (activeEl === video) img.style.display = 'none';
            else { video.style.display = 'none'; video.pause(); }
          }
        })();
      </script>
    </div>
    <div class="hero__content">
      <Image src={logoNameOnly} alt="Fullfill" class="hero__logo" width={logoNameOnly.width} height={logoNameOnly.height} />
      <h1 class="hero__headline">your personal trainer for a happier mind</h1>
      <a href="https://www.fullfill.me/try" class="btn-primary">stop scrolling. start growing.</a>
    </div>
  </div>
</section>
