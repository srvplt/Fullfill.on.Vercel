---
const archetypes = [
  { name: 'The Driven but Drained', line: 'Performing well, running on low fuel.' },
  { name: 'The Wired and Tired', line: 'The body wants to stop. The mind keeps looping.' },
  { name: 'The Midnight Thinker', line: 'Thoughts get louder at night.' },
  { name: 'The Lost in the Fog', line: 'Not falling apart, not clear either.' },
  { name: 'The Heavy Hearted', line: 'Carrying a weight nobody else can see.' },
  { name: 'The Autopilot Aviator', line: 'Getting through the days, not steering them.' },
  { name: 'The Silently Slipping', line: 'Motivation fading slowly and quietly.' },
  { name: 'The Disconnected Soul', line: 'There, but not making contact.' },
  { name: 'The Out of Sync Self', line: 'Sleep, movement and energy out of line.' },
  { name: 'The Masked Smile', line: 'Composed outside, more going on inside.' },
];
---
<section class="fa-section" id="archetypes">
  <div class="bx-wrap">
    <div class="fa-head">
      <div>
        <h2 class="bx-title fa-heading">find your <span class="accent">archetype</span></h2>
        <p class="bx-text">Ten ways a mind can feel stuck. A short quiz when you sign up shows which one is yours, and Fullfill builds your first pathway around it.</p>
      </div>
      <a href="/try" class="btn-primary">take the quiz in the app</a>
    </div>
    <div class="fa-grid">
      {archetypes.map((a) => (
        <div class="fa-card">
          <h3>{a.name}</h3>
          <p>{a.line}</p>
        </div>
      ))}
    </div>
  </div>
</section>
