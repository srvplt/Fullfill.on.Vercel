---
import Layout from '../layouts/Layout.astro';

const oldImage = (name: string) => `https://raw.githubusercontent.com/srvplt/fullfill/main/images/${name}`;
---

<Layout
  title="Contact Fullfill | Wellness & Mental Fitness App"
  description="Contact Fullfill about our wellness and mental fitness app, AI journal, emotional fitness tools, stress relief, personal growth, and corporate memberships."
  keywords="Fullfill contact, wellness app, mental fitness, emotional fitness, AI journal, stress relief app, personal growth, corporate wellness"
  canonicalPath="/contact/"
>
  <div class="legacy-contact">
    <section class="contact-main">
      <div class="contact-inner">
        <div class="contact-image">
          <img src={oldImage('photo-1604881988758-f76ad2f7aac1.jpeg')} alt="A calm moment of reflection" />
        </div>
        <div class="contact-copy">
          <h2>we'd love to hear from you</h2>
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            data-netlify-recaptcha="true"
            netlify-honeypot="bot-field"
            class="legacy-form"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden-field"><label>Don’t fill this out if you’re human: <input name="bot-field" /></label></p>
            <div class="split">
              <input type="text" name="name" placeholder="your name" aria-label="Name" autocomplete="name" required />
              <input type="email" name="email" placeholder="your email address" aria-label="Email" autocomplete="email" required />
            </div>
            <textarea name="message" rows="4" placeholder="your message" aria-label="Message" required></textarea>
            <div data-netlify-recaptcha="true"></div>
            <button type="submit">Send Message</button>
          </form>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .legacy-contact{font-family:var(--font-urbanist);color:#3d4268}.legacy-contact *{box-sizing:border-box}.legacy-contact h1,.legacy-contact h2{font-family:var(--font-urbanist);font-weight:700}
  .contact-hero{min-height:330px;display:flex;align-items:center;justify-content:center;background:var(--gradient-light);background-size:cover}.contact-hero h1{color:#fff;font-size:3.4rem;margin:0;text-align:center}
  .contact-main{background:#7c8cff;min-height:650px}.contact-inner{width:min(1200px,calc(100% - 40px));margin:0 auto;display:grid;grid-template-columns:7fr 8fr;gap:50px;min-height:650px}.contact-copy{align-self:center;color:#fff;padding:60px 0}.logo-mark{width:70px;height:70px;object-fit:contain;margin-bottom:15px}.contact-copy h2{font-size:2.5rem;line-height:1.15;margin:0 0 40px}.legacy-form{max-width:650px}.split{display:grid;grid-template-columns:1fr 1fr;gap:30px}.legacy-form input:not([type='hidden']),.legacy-form textarea{width:100%;display:block;padding:12px 0;margin-bottom:28px;border:0;border-bottom:2px solid #fff;border-radius:0;background:transparent;color:#fff;font:400 1rem var(--font-urbanist);outline:none}.legacy-form input::placeholder,.legacy-form textarea::placeholder{color:#fff;opacity:1}.legacy-form textarea{resize:vertical}.legacy-form [data-netlify-recaptcha='true']{margin:0 0 20px}.legacy-form button{border:0;border-radius:50px;background:#3f5ef0;color:#fff;padding:12px 35px;text-transform:uppercase;letter-spacing:1px;font-weight:700;cursor:pointer}.contact-image{align-self:center}.contact-image img{display:block;width:100%;max-height:560px;object-fit:cover;border-radius:22px}
  .hidden-field{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  @media(max-width:800px){.contact-hero{min-height:240px}.contact-hero h1{font-size:2.3rem}.contact-inner{grid-template-columns:1fr;width:min(100% - 40px,650px);gap:0}.contact-copy{padding:65px 0 35px}.contact-copy h2{font-size:2rem;text-align:center}.logo-mark{display:block;margin:0 auto 15px}.split{grid-template-columns:1fr;gap:0}.contact-image{padding-bottom:60px}.contact-image img{max-height:420px}}

  /* Contact flow: image first, then the invitation and form. */
  .contact-hero { display: none; }
  .contact-main { min-height: 0; padding: 48px 0 64px; }
  .contact-inner {
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
    min-height: 0;
    max-width: 920px;
  }
  .contact-image { order: 0; width: 100%; }
  .contact-image img { width: 100%; max-height: 360px; object-position: center 45%; }
  .contact-copy { order: 1; padding: 0; }
  .contact-copy h2 { margin: 0 0 30px; text-align: left; }
  .legacy-form { max-width: none; }
  @media (max-width: 800px) {
    .contact-main { padding: 28px 0 44px; }
    .contact-inner { gap: 26px; }
    .contact-copy { padding: 0; }
    .contact-copy h2 { font-size: 2rem; text-align: left; margin-bottom: 24px; }
    .contact-image { padding-bottom: 0; }
    .contact-image img { max-height: 300px; }
  }
</style>


<style>
  /* Shared landing-page type scale and brand colors. */
  .legacy-contact { color: var(--color-dark-purple); }
  .legacy-contact .contact-main {
    background: var(--gradient-light);
  }
  .legacy-contact .contact-copy h2 {
    font-size: var(--type-hero) !important;
    line-height: 1.15 !important;
    letter-spacing: 0 !important;
  }
  .legacy-contact .legacy-form input:not([type='hidden']),
  .legacy-contact .legacy-form textarea {
    font-size: var(--type-input);
  }
  .legacy-contact .legacy-form button {
    background: var(--btn-bg);
    font-family: var(--font-open-sans);
    font-size: var(--type-cta);
    min-height: 48px;
  }
  .legacy-contact .legacy-form button:hover { background: var(--btn-bg-hover); }
  @media (max-width: 767px) {
    .legacy-contact .contact-copy h2 { font-size: var(--type-section) !important; }
  }
  @media (max-width: 575px) {
    .legacy-contact .contact-copy h2 { font-size: var(--type-section) !important; }
  }

  /* Match the contributor form's browser-autofill treatment. */
  .legacy-contact .legacy-form input:not([type='hidden']):autofill,
  .legacy-contact .legacy-form textarea:autofill,
  .legacy-contact .legacy-form input:not([type='hidden']):-webkit-autofill,
  .legacy-contact .legacy-form textarea:-webkit-autofill,
  .legacy-contact .legacy-form input:not([type='hidden']):-webkit-autofill:hover,
  .legacy-contact .legacy-form input:not([type='hidden']):-webkit-autofill:focus,
  .legacy-contact .legacy-form textarea:-webkit-autofill:hover,
  .legacy-contact .legacy-form textarea:-webkit-autofill:focus {
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;
    caret-color: #fff !important;
    background-color: #7c8cff !important;
    background-image: none !important;
    border-bottom-color: rgba(255,255,255,.75) !important;
    -webkit-box-shadow: 0 0 0 1000px #7c8cff inset !important;
    box-shadow: 0 0 0 1000px #7c8cff inset !important;
    -webkit-background-clip: padding-box !important;
    transition: background-color 99999s ease-out 0s;
  }
  .legacy-contact .legacy-form input:not([type='hidden']):focus,
  .legacy-contact .legacy-form textarea:focus {
    color: #fff;
  }
</style>
