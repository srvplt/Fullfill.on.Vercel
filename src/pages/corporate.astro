---
import Layout from '../layouts/Layout.astro';
import corpPhoneImage from '../assets/images/02.profilepage.png';
const teamPhotoUrl = 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=2400&q=85';
import learnIcon from '../assets/images/2222366-26491e6d.png';
import supportIcon from '../assets/images/11031487-1c76bd0a.png';
import connectIcon from '../assets/images/10303062-b214155b.png';
import growIcon from '../assets/images/3234841-33a8600d.png';
---

<Layout
  title="Corporate Wellness & Mental Fitness | Fullfill"
  description="Give your team practical tools to build mental fitness, manage workplace stress, and develop healthier everyday habits with Fullfill."
  keywords="corporate wellness, corporate mental fitness, employee wellbeing, workplace stress, burnout prevention, mental fitness, Fullfill corporate memberships"
  canonicalPath="/corporate/"
>
  <div class="corporate-page">
    <section class="corp-hero">
      <div class="corp-hero__inner">
        <div class="corp-hero__art">
          <div class="corp-orbit"></div>
          <img src={corpPhoneImage.src} alt="Fullfill mental fitness app on a phone" />
        </div>
        <div class="corp-hero__copy">
          <h1>help your team feel better</h1>
          <a class="corp-button" href="#enroll">GET IT FOR MY TEAM</a>
        </div>
      </div>
    </section>

    <div class="page-sticky-wrapper corp-pressure-sticky-wrapper">
      <section class="corp-pressure">
        <div class="corp-pressure__bg" aria-hidden="true"><img src={teamPhotoUrl} alt="People working together at desks in a modern office" /></div>
        <div class="corp-panel-inner corp-pressure__layout">
          <div class="corp-pressure__copy">
            <h2>work is changing.<br /><span>people need support.</span></h2>
            <p>Uncertainty, constant change, and pressure to keep up can make it harder to focus, connect, and recover. Supporting mental fitness helps people build the everyday skills to meet those moments.</p>
          </div>
          <div class="corp-pullquote">
            <img class="corp-pullquote__avatar" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=160&h=160&q=80" alt="Portrait of a person" loading="lazy" />
            <span class="corp-pullquote__mark">“</span>
            <p>Fullfill helped me build small habits that made stressful workdays feel more manageable.</p>
          </div>
          <div class="corp-pressure__chips" aria-label="Areas where teams may need support">
            <span>Stress &amp; recovery</span><span>Focus &amp; clarity</span><span>Resilience</span><span>Connection</span>
          </div>
        </div>
      </section>
    </div>

    <div class="page-sticky-wrapper corp-offer-sticky-wrapper">
      <section class="corp-offer">
        <div class="corp-panel-inner corp-offer__layout">
          <div class="corp-offer__copy">
            <h2>add fullfill to your<br /><span>corporate wellness plan.</span></h2>
            <p>See the benefits for yourself. Hear from your teams directly. Enroll in our free pilot program so your team can feel the difference after using Fullfill.</p>
          </div>
          <div class="corp-offer__card">
            <p class="corp-offer__label">INTRODUCTORY OFFER</p>
            <p class="corp-offer__number">12 months free</p>
            <div class="corp-offer__rule"></div>
            <p class="corp-offer__detail">For 200 employees</p>
            <a class="corp-button" href="#enroll">CLAIM NOW</a>
          </div>
        </div>
      </section>
    </div>

    <div class="page-sticky-wrapper">
      <section class="corp-benefits">
        <div class="corp-panel-inner">
          <div class="corp-section-heading">
            <h2>four ways we <span>support your team.</span></h2>
          </div>
          <div class="corp-benefit-grid">
            <article class="corp-benefit">
              <div class="corp-benefit__icon"><img src={learnIcon.src} alt="" loading="lazy" /></div>
              <h3>content that helps</h3>
              <p>Short, practical guidance for everyday wellbeing.</p>
            </article>
            <article class="corp-benefit">
              <div class="corp-benefit__icon"><img src={supportIcon.src} alt="" loading="lazy" /></div>
              <h3>support when needed</h3>
              <p>Find the right support when it matters.</p>
            </article>
            <article class="corp-benefit">
              <div class="corp-benefit__icon"><img src={connectIcon.src} alt="" loading="lazy" /></div>
              <h3>connection without judgement</h3>
              <p>Help people feel connected and less alone.</p>
            </article>
            <article class="corp-benefit">
              <div class="corp-benefit__icon"><img src={growIcon.src} alt="" loading="lazy" /></div>
              <h3>progress that sticks</h3>
              <p>Build small habits that last.</p>
            </article>
          </div>
        </div>
      </section>
    </div>

    <section class="corp-enroll" id="enroll">
      <div class="corp-enroll__inner">
        <div class="corp-enroll__copy">
          <h2>let’s connect</h2>
          
        </div>
        <form
          name="corporate-enrollment"
          method="POST"
          data-netlify="true"
          data-netlify-recaptcha="true"
          netlify-honeypot="bot-field"
          class="corp-form"
        >
          <input type="hidden" name="form-name" value="corporate-enrollment" />
          <p class="corp-hidden-field"><label>Don’t fill this out if you’re human: <input name="bot-field" /></label></p>
          <label for="corp-name">Your name</label>
          <input id="corp-name" type="text" name="name" placeholder="How should we address you?" autocomplete="name" required />
          <label for="corp-email">Work email</label>
          <input id="corp-email" type="email" name="email" placeholder="you@company.com" autocomplete="email" required />
          <label for="corp-message">Tell us about your team</label>
          <textarea id="corp-message" name="message" rows="4" placeholder="Team size, what you’re looking for, or any questions…" required></textarea>
          <div data-netlify-recaptcha="true"></div>
          <button class="corp-button" type="submit">SEND ENQUIRY</button>
        </form>
      </div>
    </section>
  </div>
</Layout>

<style>
  .corporate-page {
    --corp-ink: var(--color-dark-purple);
    --corp-muted: var(--color-text-muted);
    --corp-purple: var(--color-brand);
    --corp-lilac: var(--color-lavender);
    --corp-card: rgba(255,255,255,.72);
    color: var(--corp-ink);
    font-family: var(--font-urbanist);
  }
  .corporate-page * { box-sizing: border-box; }
  .corporate-page h1, .corporate-page h2, .corporate-page h3, .corporate-page p { margin-top: 0; }
  .corp-hero {
    position: relative;
    min-height: calc(100svh - var(--site-header-height));
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--gradient-light);
    isolation: isolate;
  }
  .corp-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -20%;
    background-image: url('/heart-pattern.svg');
    background-repeat: repeat;
    background-size: 276.48px 171.36px;
    background-position: center;
    opacity: .09;
    pointer-events: none;
    transform: rotate(-18deg) scale(1.4);
  }
  .corp-hero__inner, .corp-panel-inner, .corp-enroll__inner {
    width: min(1140px, calc(100% - 48px));
    margin-inline: auto;
  }
  .corp-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
    padding-block: 32px 42px;
  }
  .corp-hero__art {
    min-width: 0;
    min-height: 520px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .corp-orbit {
    position: absolute;
    width: min(34vw, 440px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(140deg, rgba(255,255,255,.68), rgba(167,184,255,.65) 48%, rgba(197,170,243,.72));
    box-shadow: 0 30px 80px rgba(76,67,170,.10);
  }
  .corp-hero__art img {
    position: relative;
    z-index: 1;
    display: block;
    width: auto;
    height: min(68svh, 600px);
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 24px 30px rgba(39,17,61,.16));
  }
  .corp-hero__copy { max-width: 570px; padding: 28px 0; }
  .corp-eyebrow {
    margin: 0 0 18px;
    color: var(--corp-purple);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .16em;
    line-height: 1.4;
  }
  .corp-hero .corp-eyebrow { color: rgba(255,255,255,.95); }
  .corp-hero h1 {
    max-width: 650px;
    margin: 0 0 22px;
    color: #fff;
    font-size: clamp(38px, 4.5vw, 64px);
    font-weight: 750;
    line-height: .99;
    letter-spacing: -.045em;
  }
  .corp-hero h1 span { color: #fff; }
  .corp-intro {
    max-width: 500px;
    margin-bottom: 30px;
    color: #fff;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.55;
  }
  .corp-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 52px;
    padding: 15px 24px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--corp-purple);
    color: #fff;
    font: 800 12px/1 var(--font-urbanist);
    letter-spacing: .09em;
    text-decoration: none;
    cursor: pointer;
    transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
  }
  .corp-button:hover { transform: translateY(-2px); background: #484bc0; box-shadow: 0 10px 24px rgba(39,17,61,.15); }
  .corp-button span { font-size: 18px; line-height: .7; }
  .corp-proof { margin: 17px 0 0; color: rgba(255,255,255,.9); font-size: 13px; }
  .page-sticky-wrapper { position: relative; }
  .page-sticky-wrapper > section { overflow: hidden; }
  .corp-pressure { display: flex; align-items: center; background: var(--color-brand-bg); }
  .corp-pressure__layout {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    grid-template-rows: 1fr auto;
    align-items: center;
    gap: 28px 7%;
    padding-block: clamp(44px, 7vh, 80px);
  }
  .corp-pressure__copy h2, .corp-offer__copy h2, .corp-section-heading h2, .corp-enroll h2 {
    margin-bottom: 22px;
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.02;
    letter-spacing: -.04em;
    font-weight: 750;
  }
  .corp-pressure__copy h2 span, .corp-section-heading h2 span, .corp-enroll h2 span { color: var(--corp-purple); }
  .corp-pressure__copy > p:last-child, .corp-offer__copy > p:not(.corp-eyebrow), .corp-section-heading > p:last-child, .corp-enroll__copy > p:not(.corp-eyebrow) {
    max-width: 510px;
    color: var(--corp-muted);
    font-size: 17px;
    line-height: 1.65;
  }
  .corp-pressure__visual { min-width: 0; position: relative; align-self: center; padding: 0 0 36px 30px; }
  .corp-pressure__visual > img { align-self: center; }
  .corp-pressure__visual > img {
    display: block;
    width: 100%;
    height: clamp(250px, 40vh, 390px);
    object-fit: cover;
    border-radius: 28px;
    box-shadow: 0 20px 45px rgba(39,17,61,.12);
  }
  .corp-pullquote {
    position: absolute;
    right: -4px;
    bottom: 0;
    width: min(290px, 78%);
    padding: 18px 22px 20px;
    border: 1px solid rgba(255,255,255,.8);
    border-radius: 20px;
    background: rgba(255,255,255,.88);
    box-shadow: 0 14px 35px rgba(39,17,61,.12);
    backdrop-filter: blur(12px);
  }
  .corp-pullquote__mark { display: block; color: var(--corp-purple); font-size: 36px; font-weight: 800; line-height: .8; }
  .corp-pullquote p { margin: 8px 0 0; font-size: 15px; font-weight: 700; line-height: 1.4; }
  .corp-pressure__chips {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  .corp-pressure__chips span {
    padding: 10px 16px;
    border: 1px solid #dfe1ff;
    border-radius: 999px;
    background: #fff;
    color: #514e83;
    font-size: 13px;
    font-weight: 700;
  }
  .corp-offer {
    display: flex;
    align-items: center;
    color: #fff;
    background: radial-gradient(circle at 82% 18%, rgba(177,190,255,.55), transparent 35%), var(--gradient-middle);
  }
  .corp-offer__layout {
    display: grid;
    grid-template-columns: 1fr minmax(280px, .72fr);
    align-items: center;
    gap: clamp(36px, 8vw, 110px);
    padding-block: clamp(48px, 7vh, 82px);
  }
  .corp-offer .corp-eyebrow { color: #e3e5ff; }
  .corp-offer__copy h2 { color: #fff; }
  .corp-offer__copy h2 span { color: #d8dbff; }
  .corp-offer__copy > p:not(.corp-eyebrow) { color: rgba(255,255,255,.88); margin-bottom: 28px; }
  .corp-button--light { background: #fff; color: #4c4fc4; }
  .corp-button--light:hover { background: #f0f1ff; }
  .corp-offer__card {
    position: relative;
    overflow: hidden;
    padding: clamp(30px, 4vw, 48px);
    border: 1px solid rgba(255,255,255,.58);
    border-radius: 32px;
    background: linear-gradient(145deg, rgba(255,255,255,.94), rgba(239,240,255,.87));
    box-shadow: 0 28px 70px rgba(31,24,103,.2);
    color: var(--corp-ink);
    text-align: center;
  }
  .corp-offer__spark { display: block; margin-bottom: 14px; color: var(--corp-purple); font-size: 30px; }
  .corp-offer__label { margin: 0 0 12px; color: var(--corp-purple); font-size: 12px; font-weight: 800; letter-spacing: .16em; }
  .corp-offer__number { margin: 0; font-size: clamp(42px, 4.5vw, 60px); font-weight: 800; letter-spacing: -.05em; line-height: 1; }
  .corp-offer__free { margin: 5px 0 0; color: var(--corp-purple); font-size: 24px; font-weight: 700; }
  .corp-offer__rule { height: 1px; margin: 24px 0 18px; background: #d9dcff; }
  .corp-offer__detail { margin-bottom: 10px; font-size: 17px; font-weight: 800; }
  .corp-offer__note { margin: 0; color: var(--corp-muted); font-size: 14px; line-height: 1.5; }
  .corp-offer__card .corp-button { margin-top: 20px; }
  .corp-benefit__icon img { display: block; opacity: 1; visibility: visible; }
  .corp-benefits { display: flex; align-items: center; background: linear-gradient(145deg, var(--color-brand-bg) 0%, #f8f8ff 55%, var(--color-brand-pale) 100%); }
  .corp-benefits .corp-panel-inner { padding-block: clamp(40px, 6vh, 68px); }
  .corp-section-heading { max-width: 690px; margin: 0 auto 34px; text-align: center; }
  .corp-section-heading .corp-eyebrow { margin-bottom: 14px; }
  .corp-section-heading h2 { margin-bottom: 14px; }
  .corp-section-heading > p:last-child { margin-inline: auto; font-size: 16px; }
  .corp-benefit-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 14px; }
  .corp-benefit {
    min-width: 0;
    padding: 25px 20px 24px;
    border: 1px solid rgba(255,255,255,.92);
    border-radius: 24px;
    background: rgba(255,255,255,.76);
    box-shadow: 0 12px 30px rgba(55,53,132,.06);
  }
  .corp-benefit__icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin-bottom: 22px;
    border-radius: 18px;
    background: linear-gradient(145deg, #e2e5ff, #f2e7ff);
  }
  .corp-benefit__icon img { width: 34px; height: 34px; object-fit: contain; filter: brightness(0) saturate(100%); }
  .corp-benefit__index { margin-bottom: 10px; color: var(--corp-purple); font-size: 10px; font-weight: 800; letter-spacing: .12em; }
  .corp-benefit h3 { margin-bottom: 12px; font-size: 21px; line-height: 1.1; font-weight: 750; }
  .corp-benefit > p:last-child { margin-bottom: 0; color: var(--corp-muted); font-size: 14px; line-height: 1.55; }
  .corp-benefits__footnote { margin: 20px 0 0; color: #706b84; font-size: 11px; line-height: 1.45; text-align: center; }
  .corp-enroll { background: #fff; display: flex; align-items: center; min-height: calc(100svh - var(--site-header-height) - var(--footer-height, 100px)); }
  .corp-enroll__inner {
    display: grid;
    grid-template-columns: .9fr 1fr;
    align-items: center;
    gap: clamp(42px, 8vw, 100px);
    padding-block: clamp(28px, 4vh, 52px);
  }
  .corp-enroll h2 { font-size: clamp(38px, 4.6vw, 62px); }
  .corp-enroll__copy > p:not(.corp-eyebrow) { margin-bottom: 26px; }
  .corp-enroll__aside { display: flex; align-items: flex-start; max-width: 360px; color: #6a6481; }
  .corp-enroll__aside p { margin: 0; font-size: 16px; line-height: 1.5; }
  .corp-form {
    padding: clamp(26px, 4vw, 44px);
    border: 1px solid #e6e7fb;
    border-radius: 28px;
    background: #f8f8ff;
    box-shadow: 0 20px 55px rgba(39,17,61,.07);
  }
  .corp-form label { display: block; margin: 0 0 7px; color: #4d4864; font-size: 12px; font-weight: 800; }
  .corp-form input:not([type="hidden"]), .corp-form textarea {
    display: block;
    width: 100%;
    margin: 0 0 20px;
    padding: 13px 15px;
    border: 1px solid #dfe1f7;
    border-radius: 12px;
    outline: none;
    background: #fff;
    color: var(--corp-ink);
    font: 500 15px/1.4 var(--font-urbanist);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .corp-form input:focus, .corp-form textarea:focus { border-color: var(--corp-purple); box-shadow: 0 0 0 3px rgba(94,97,214,.12); }
  .corp-form input::placeholder, .corp-form textarea::placeholder { color: #9692a8; }
  .corp-form textarea { min-height: 112px; resize: vertical; }
  .corp-form [data-netlify-recaptcha="true"] { margin: 0 0 20px; }
  .corp-form__privacy { margin: 13px 0 0; color: #817b94; font-size: 11px; line-height: 1.4; }
  .corp-hidden-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  @media (min-width: 768px) {
    .corp-pressure, .corp-offer, .corp-benefits {
      min-height: calc(100svh - var(--site-header-height));
    }
    .corp-pressure__layout, .corp-offer__layout, .corp-benefits .corp-panel-inner { max-height: calc(100svh - var(--site-header-height)); }
  }
  @media (max-width: 1000px) {
    .corp-hero__inner { gap: 28px; grid-template-columns: .85fr 1.15fr; }
    .corp-hero__art { min-height: 460px; }
    .corp-hero__art img { height: min(70svh, 600px); max-width: 100%; }
    .corp-orbit { width: min(42vw, 390px); }
    .corp-benefit-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .corp-benefits .corp-panel-inner { padding-block: 48px; }
    .corp-benefit { padding: 22px; }
  }
  @media (max-width: 767px) {
    .corp-hero { height: calc(100svh - var(--site-header-height)); min-height: 600px; max-height: none; align-items: stretch; }
    .corp-hero__inner {
      width: 100%;
      height: 100%;
      min-height: 0;
      grid-template-columns: minmax(0,1fr);
      grid-template-rows: 48% minmax(0,1fr);
      gap: 0;
      padding: 0;
    }
    .corp-hero__art { grid-row: 1; min-height: 0; justify-content: flex-start; align-items: flex-end; padding-left: 20px; overflow: hidden; }
    .corp-orbit { left: 16px; bottom: 2%; width: min(76vw, 340px); }
    .corp-hero__art img { width: min(100vw, 420px); height: auto; max-height: 56svh; max-width: none; object-fit: contain; object-position: center bottom; }
    .corp-hero__copy { grid-row: 2; align-self: start; padding: 12px 22px 28px 32px; max-width: 640px; }
    .corp-hero .corp-eyebrow { margin-bottom: 10px; font-size: 10px; }
    .corp-hero h1 { max-width: 580px; margin-bottom: 13px; font-size: clamp(29px, 7vw, 42px); line-height: 1.02; }
    .corp-intro { margin-bottom: 18px; font-size: 15px; line-height: 1.42; }
    .corp-button { min-height: 47px; padding: 13px 18px; gap: 10px; font-size: 10px; }
    .corp-proof { margin-top: 10px; font-size: 11px; }
    .page-sticky-wrapper { height: 240svh !important; }
    .page-sticky-wrapper > section { height: calc(100lvh - var(--site-header-height)) !important; min-height: 0 !important; overflow-x: hidden; overflow-y: auto; }
    .corp-pressure, .corp-offer, .corp-benefits { align-items: flex-start; }
    .corp-panel-inner { width: calc(100% - 36px); }
    .corp-pressure__layout { grid-template-columns: minmax(0,1fr); grid-template-rows: auto auto auto; gap: 16px; padding-block: 30px 24px; }
    .corp-pressure__copy .corp-eyebrow { margin-bottom: 10px; }
    .corp-pressure__copy h2, .corp-offer__copy h2, .corp-section-heading h2 { font-size: clamp(31px, 8vw, 42px); margin-bottom: 12px; }
    .corp-pressure__copy > p:last-child, .corp-offer__copy > p:not(.corp-eyebrow), .corp-section-heading > p:last-child { font-size: 14px; line-height: 1.48; margin-bottom: 0; }
    .corp-pressure__visual { padding: 0 0 24px 14px; }
    .corp-pressure__visual > img { height: clamp(145px, 23vh, 210px); border-radius: 20px; }
    .corp-pullquote { width: min(245px, 82%); padding: 12px 15px; border-radius: 15px; }
    .corp-pullquote__mark { font-size: 26px; }
    .corp-pullquote p { margin-top: 5px; font-size: 12px; }
    .corp-pressure__chips { gap: 7px; margin-top: 0; }
    .corp-pressure__chips span { padding: 8px 11px; font-size: 11px; }
    .corp-offer__layout { grid-template-columns: minmax(0,1fr); gap: 20px; padding-block: 30px 24px; }
    .corp-offer__copy > p:not(.corp-eyebrow) { margin-bottom: 16px; }
    .corp-offer__card { width: min(100%, 390px); margin-inline: auto; padding: 19px 22px; border-radius: 23px; }
    .corp-offer__spark { margin-bottom: 6px; font-size: 22px; }
    .corp-offer__label { margin-bottom: 7px; font-size: 10px; }
    .corp-offer__number { font-size: 43px; }
    .corp-offer__free { font-size: 19px; }
    .corp-offer__rule { margin: 13px 0 10px; }
    .corp-offer__detail { margin-bottom: 6px; font-size: 14px; }
    .corp-offer__note { font-size: 12px; }
    .corp-benefits .corp-panel-inner { padding-block: 30px 22px; }
    .corp-section-heading { margin-bottom: 18px; }
    .corp-section-heading .corp-eyebrow { margin-bottom: 8px; }
    .corp-section-heading > p:last-child { display: none; }
