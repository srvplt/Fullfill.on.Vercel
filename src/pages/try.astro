---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Download Fullfill: stop scrolling, start living"
  description="Download the Fullfill app and start your personal growth journey."
  ogTitle="Fullfill: stop scrolling, start living"
  ogImage="/images/og-image.jpg"
  canonicalPath="/try/"
>

<script is:inline>
  const userAgent = navigator.userAgent;

  if (/iPad|iPhone|iPod/.test(userAgent)) {
    window.location.replace("https://apps.apple.com/app/id6757362734");
  } else if (/android/i.test(userAgent)) {
    window.location.replace("https://play.google.com/store/apps/details?id=com.mycompany.fullfill2");
  }
</script>


<section class="try-main">

  <div class="try-container">

    <div class="try-text">

      <h1>stop scrolling, <span class="accent">start living</span></h1>
      <p class="try-sub">Download Fullfill, your personal trainer for a happier mind.</p>

      <div class="btn-row">

        <a 
          class="btn" 
          href="https://apps.apple.com/app/id6757362734"
        >
          iOS
        </a>

        <a 
          class="btn" 
          href="https://play.google.com/store/apps/details?id=com.mycompany.fullfill2"
        >
          Android
        </a>

      </div>

    </div>


    <div class="qr-wrap">

      <img 
        class="qr" 
        src="/images/qr-code.png" 
        alt="Download Fullfill app QR code"
      />

    </div>


  </div>

</section>


</Layout>


<style>

.try-main {
  min-height: calc(100vh - 160px);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gradient-dark);
  padding: 40px 20px;
  color: white;
}


.try-container {
  max-width: 900px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 60px;
}


.try-text {
  flex: 1;
}


h1 {
  font-family: var(--font-urbanist);
  font-size: 44px;
  font-weight: 700;
  line-height: 1.1;
  margin: 0 0 12px;
  color: #ffffff;
}


.try-sub {
  font-family: var(--font-poppins);
  font-size: 17px;
  line-height: 1.55;
  margin: 0 0 28px;
  color: #ffffff;
}

.btn-row {
  display: flex;
  gap: 12px;
}


.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 150px;
  min-height: 52px;
  padding: 0 28px;
  background: #5E61D6;
  border: 0;
  border-radius: 999px;
  color: #ffffff;
  text-decoration: none;
  font-family: var(--font-poppins);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}


.btn:hover { background: #4A4DC2; }

.qr-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-start;
}


.qr {
  width: 220px;
  background: white;
  padding: 10px;
  border-radius: 14px;
}


@media (max-width: 768px) {

  .try-container {
    flex-direction: column;
    text-align: center;
  }


  .btn-row {
    justify-content: center;
  }


  .qr-wrap {
    justify-content: center;
  }


  h1 {
    font-size: 32px;
  }

}

</style>
