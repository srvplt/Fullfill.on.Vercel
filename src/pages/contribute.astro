---
import Layout from '../layouts/Layout.astro';
import fullfillIcon from '../assets/images/FinalLogoNameOnly.png';
const oldImage = (name: string) => `https://raw.githubusercontent.com/srvplt/fullfill/main/images/${name}`;
---

<Layout
  title="Contribute to Fullfill | Wellness Content & Experts"
  description="Become a Fullfill contributor. Share wellness articles, podcasts, guided meditation, breathwork and expertise, and reach people interested in mental fitness and personal growth."
  keywords="Fullfill contributor, wellness content, guided meditation, breathwork, mental fitness, personal growth, mindfulness, wellness professionals, wellness articles, podcast"
  canonicalPath="/contribute/"
>
  <div class="legacy-contribute">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-phone"><img src={oldImage('01TopImagePhone.png')} alt="Fullfill wellness app" /></div>
        <div class="hero-copy">
          <h1>contribute to a<br />happier community</h1>
          <a class="button button-light" href="#contribute-form">GET IN TOUCH</a>
        </div>
      </div>
    </section>

    <div class="fullpage-sticky-wrapper"><section class="feature feature-white">
      <div class="feature-inner">
        <div class="feature-copy">
          <h2>get featured on Fullfill</h2>
          <p>Host your podcast episodes or guided meditation sessions on Fullfill. We’ll feature you, with direct links to your social channel or website - helping you grow your audience.</p>
          <a class="button button-blue" href="#contribute-form">GET FEATURED</a>
        </div>
        <div class="feature-art feature-art-phone">
          <img class="shape" src={oldImage('shape-08.png')} alt="" />
          <div class="circle" style={`background-image:url('${oldImage('photo-1593697909683-bccb1b9e68a4.jpeg')}')`}></div>
        </div>
      </div>
    </section></div>

    <div class="fullpage-sticky-wrapper"><section class="feature feature-blogging">
      <div class="feature-inner">
        <div class="feature-spacer"></div>
        <div class="feature-copy feature-copy-light">
          <h2>write. share. grow</h2>
          <p>Publish your wellness articles, reflections, or insights on Fullfill. We’ll back link all content to your blog. Expand your readership and inspire a wider community.</p>
          <a class="button button-dark" href="#contribute-form">GET FEATURED</a>
        </div>
      </div>
    </section></div>

    <div class="fullpage-sticky-wrapper"><section class="feature feature-clients">
      <div class="feature-inner">
        <div class="feature-copy">
          <h2>reach new clients</h2>
          <p>List your practice on Fullfill and connect with new clients seeking trusted professionals. We’ll showcase your profile including links to your site or booking platform.</p>
          <a class="button button-blue-outline" href="#contribute-form">GET LISTED</a>
        </div>
        <div class="clients-art"></div>
      </div>
    </section></div>

    <section class="contribute-form" id="contribute-form">
      <div class="form-inner">
        <div class="form-copy">
          <h2>wish to contribute?</h2>
          <img class="contribute-title-icon" src={fullfillIcon.src} alt="" aria-hidden="true" />
          <form
            name="contributor"
            method="POST"
            data-netlify="true"
            data-netlify-recaptcha="true"
            netlify-honeypot="bot-field"
            class="legacy-form"
          >
            <input type="hidden" name="form-name" value="contributor" />
            <p class="hidden-field"><label>Don’t fill this out if you’re human: <input name="bot-field" /></label></p>
            <input type="text" name="name" placeholder="your name" aria-label="Name" autocomplete="name" required />
            <input type="email" name="email" placeholder="your email address" aria-label="Email" autocomplete="email" required />
            <textarea name="message" rows="6" placeholder="your message" aria-label="Message" required></textarea>
            <div data-netlify-recaptcha="true"></div>
            <button class="button button-submit" type="submit">Send Message</button>
          </form>
        </div>
        <div class="form-art"></div>
      </div>
    </section>
  </div>

<script>
  // Keep the final contributor form sized to the real footer on this page.
  function updateContributorFooterHeight() {
    const footer = document.getElementById('footer');
    if (!footer) return;
    document.documentElement.style.setProperty('--footer-height', footer.getBoundingClientRect().height + 'px');
  }
  updateContributorFooterHeight();
  window.addEventListener('resize', updateContributorFooterHeight);
  const contributorFooter = document.getElementById('footer');
  if (contributorFooter && 'ResizeObserver' in window) {
    new ResizeObserver(updateContributorFooterHeight).observe(contributorFooter);
  }
</script>

</Layout>

<style>
  .legacy-contribute { --blue:var(--btn-bg); --dark:#3d4268; font-family:var(--font-urbanist); }
  .legacy-contribute *{box-sizing:border-box}.legacy-contribute h1,.legacy-contribute h2,.legacy-contribute p{margin-top:0}.legacy-contribute h1,.legacy-contribute h2{font-family:var(--font-urbanist);font-weight:700}.legacy-contribute p{font-family:var(--font-urbanist);font-weight:400}
  .legacy-contribute .hero{height:calc(100dvh - var(--site-header-height)) !important;min-height:0 !important;max-height:calc(100dvh - var(--site-header-height)) !important;background:var(--gradient-light);overflow:hidden;position:relative}.legacy-contribute .hero::before{content:"";position:absolute;inset:0;background-image:url('/heart-pattern.svg');background-repeat:space;background-size:88px 88px;background-position:center;opacity:.09;pointer-events:none;z-index:0;transform:rotate(-18deg) scale(1.4);inset:-20%}.legacy-contribute .hero-inner,.feature-inner,.form-inner{width:min(1200px,calc(100% - 40px));margin:0 auto;display:grid;grid-template-columns:1fr 1fr;min-height:inherit}.legacy-contribute .hero-inner{height:100%;min-height:0;position:relative;z-index:1}.hero-phone{display:flex;align-items:flex-end;justify-content:center;min-height:0;overflow:hidden}.hero-phone img{width:auto;max-width:none;max-height:none;height:min(78svh, 650px);object-fit:contain;margin-top:0;margin-bottom:0;transform:scale(1);transform-origin:center bottom}.hero-copy{align-self:center;padding:40px 20px 40px 0;color:#fff;transform:translateY(11vh)}.hero-copy h1{font-size:2.5rem;line-height:1.12;margin-bottom:34px}.hero-copy p{max-width:570px;font-size:1.5rem;line-height:1.4;margin-bottom:34px}
  .button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:9px 35px 10px;border:0;border-radius:50px;text-decoration:none;text-transform:uppercase;font-size:.875rem;font-weight:700;letter-spacing:1px;transition:transform .2s ease}.button:hover{transform:translateY(-2px)}.button-light,.button-blue,.button-blue-outline,.button-dark,.button-submit{background:var(--btn-bg);color:#fff}.button:hover{background:var(--btn-bg-hover);color:#fff}
  .feature{overflow:hidden}.feature-white{background:#fff}.feature-inner{min-height:640px}.feature-copy{align-self:center;padding:40px 30px 40px 0;color:#3d4268}.feature-copy h2{font-size:2.5rem;line-height:1.15;margin-bottom:30px}.feature-white .feature-copy h2{color:var(--color-brand)}.feature-copy p{font-size:1.25rem;line-height:1.6;margin-bottom:30px}.feature-art{position:relative;min-height:636px;display:flex;align-items:center;justify-content:center}.feature-art .shape{width:min(614px,100%);height:auto}.feature-art .circle{position:absolute;width:450px;height:450px;border-radius:50%;background-size:cover;background-position:center}
  .feature-blogging{min-height:740px;background-image:linear-gradient(90deg,rgba(0,0,0,.08),rgba(0,0,0,.12)),url('https://raw.githubusercontent.com/srvplt/fullfill/main/images/is-blogging-still-relevant.jpg');background-size:cover;background-position:center}.feature-blogging .feature-inner{min-height:740px}.feature-copy-light{color:#fff;padding-left:20px;padding-right:0}.feature-copy-light h2{margin-bottom:20px}.feature-copy-light p{max-width:560px}
  .feature-clients{background:#fff}.feature-clients .feature-inner{min-height:640px}.clients-art{min-height:540px;align-self:center;border-radius:18px;background-image:linear-gradient(135deg,rgba(94,97,214,.38),rgba(86,105,230,.34)),url('https://raw.githubusercontent.com/srvplt/fullfill/main/images/Man-therapy.webp');background-repeat:no-repeat;background-position:center;background-size:cover;opacity:1}
  .contribute-form{background:var(--gradient-light);color:#fff;overflow:hidden;position:relative;top:auto;height:calc(100dvh - var(--site-header-height) - var(--footer-height, 100px));min-height:0}.form-inner{height:100%;min-height:0} .form-copy{align-self:start;padding:clamp(24px,6vh,60px) 50px 40px 0}.form-copy h2{font-size:2.5rem;line-height:1.15;margin-bottom:40px;color:#fff}.legacy-form{width:100%;max-width:600px}.legacy-form input:not([type='hidden']),.legacy-form textarea{width:100%;display:block;padding:12px 0;margin-bottom:22px;border:0;border-bottom:2px solid rgba(255,255,255,.75);border-radius:0;background:transparent;color:#fff;font:400 1rem var(--font-urbanist);outline:none}.legacy-form input::placeholder,.legacy-form textarea::placeholder{color:#fff;opacity:.9}.legacy-form textarea{resize:vertical}.legacy-form [data-netlify-recaptcha='true']{margin:0 0 20px}.button-submit{background:var(--btn-bg);color:#fff;cursor:pointer}.hidden-field{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}.form-art{min-height:0;background-image:url('https://raw.githubusercontent.com/srvplt/fullfill/main/images/01TopImagePhone2.png');background-repeat:no-repeat;background-position:center bottom;background-size:contain}
  @media(max-width:991px){.legacy-contribute .hero{height:calc(100svh - var(--site-header-height)) !important;min-height:0 !important;max-height:calc(100svh - var(--site-header-height)) !important}.hero-inner,.feature-inner,.form-inner{grid-template-columns:1fr}.legacy-contribute .hero-inner{height:100%;min-height:0}.hero-phone{height:52%;min-height:0}.hero-phone img{height:100%;width:auto;max-width:none;max-height:100%;object-fit:contain;margin:0}.hero-copy{padding:45px 20px 70px;text-align:center;transform:none}.hero-copy p{margin-left:auto;margin-right:auto}.feature-inner{min-height:auto}.feature-copy{text-align:center;padding:70px 25px 25px}.feature-art{min-height:500px}.feature-art .circle{width:425px;height:425px}.feature-blogging .feature-inner{min-height:740px}.feature-spacer{display:none}.feature-copy-light{text-align:left;align-self:start;padding:120px 25px 50px}.feature-clients .feature-inner{min-height:auto}.clients-art{min-height:420px;margin:0 25px 60px}.form-inner{min-height:0;height:100%;align-items:center}.form-copy{padding:28px 25px 20px}.form-copy h2{text-align:center;margin-bottom:22px}.form-art{min-height:0;height:100%;background-position:center center}}
  @media(max-width:575px){.legacy-contribute .hero{height:calc(100svh - var(--site-header-height)) !important;min-height:0 !important;max-height:calc(100svh - var(--site-header-height)) !important}.hero-inner,.feature-inner,.form-inner{width:100%}.legacy-contribute .hero-inner{height:100%;min-height:0}.hero-phone{height:52%;min-height:0;align-items:flex-end}.hero-phone img{height:100%;width:auto;max-width:none;max-height:100%;object-fit:contain;margin:0}.hero-copy{padding:0 29px 28px;transform:none}.hero-copy h1{font-size:1.875rem}.hero-copy p{font-size:1rem;margin-bottom:28px}.feature-copy{padding:55px 29px 0}.feature-copy h2{font-size:1.875rem}.feature-copy p{font-size:1rem}.feature-art{min-height:291px}.feature-art .shape{width:100%}.feature-art .circle{width:185px;height:185px}.feature-blogging,.feature-blogging .feature-inner{min-height:650px}.feature-copy-light{padding:80px 29px 40px}.feature-clients .feature-copy{padding-bottom:35px}.clients-art{min-height:300px;margin:0 29px 50px}.contribute-form{height:calc(100dvh - var(--site-header-height) - var(--footer-height, 100px));min-height:0}.form-inner{min-height:0;height:100%;align-items:center}.form-copy{padding:20px 29px 16px}.form-copy h2{font-size:1.875rem;margin-bottom:18px;color:var(--btn-bg)}.legacy-form input:not([type='hidden']),.legacy-form textarea{margin-bottom:14px;padding:8px 0}.legacy-form textarea{rows:3}.form-art{min-height:0;height:100%;background-position:center center}}

  /* The secondary phone artwork is decorative on mobile and was rendering as a small, unexplained image beneath the form. */
  @media(max-width:767px){.legacy-contribute .form-art{display:none!important}}

  /* Mobile hero follows the landing page's two-column-to-one-column pattern:
     phone/artwork first, then left-aligned brand copy and CTA. */
  @media(max-width:767px){
    .legacy-contribute .hero-inner{
      display:grid;
      grid-template-columns:minmax(0,1fr);
      grid-template-rows:57dvh minmax(0,1fr);
      align-items:stretch;
      width:100%;
    }
    .legacy-contribute .hero-phone{
      grid-row:1;
      height:auto;
      min-height:0;
      width:100%;
      justify-content:flex-start;
      align-items:flex-end;
      padding:0 0 0 16px;
    }
    .legacy-contribute .hero-phone img{
      height:100%;
      width:auto;
      max-width:none;
      max-height:52dvh;
      object-fit:contain;
      object-position:left bottom;
    }
    .legacy-contribute .hero-copy{
      grid-row:2;
      align-self:start;
      width:100%;
      max-width:none;
      padding:18px 20px 28px 32px;
      text-align:left;
      transform:none;
    }
    .legacy-contribute .hero-copy h1{
      font-size:27.2px;
      line-height:1.1;
      text-align:left;
      margin:0 0 18px;
    }
    .legacy-contribute .hero-copy .button{
      align-self:flex-start;
    }
    .legacy-contribute .feature-inner,
    .legacy-contribute .form-inner{
      grid-template-columns:minmax(0,1fr);
    }
  }
  @media(max-width:575px){
    .legacy-contribute .hero-inner{
      grid-template-rows:54dvh minmax(0,1fr);
    }
    .legacy-contribute .hero-phone{padding:18px 0 0 16px}
    .legacy-contribute .hero-phone img{max-height:48dvh}
    .legacy-contribute .hero-copy{padding:18px 20px 28px 32px}
    .legacy-contribute .hero-copy h1{font-size:27.2px}
  }




  /* Contact-page heart mark pattern: H=72px, 1.92H horizontal pitch,
     1.19H row pitch, alternate rows offset by 0.96H. */
  .legacy-contribute .hero::before {
    inset: 0;
    background-repeat: repeat;
    background-size: 180px 111.6px;
    background-position: center;
    opacity: .12;
    transform: none;
  }

  /* Match the landing page's shared type scale while keeping this page's layout. */
  .legacy-contribute .hero-copy h1,
  .legacy-contribute .feature-copy h2,
  .legacy-contribute .form-copy h2 {
    font-size: var(--type-hero) !important;
    line-height: 1.15 !important;
    letter-spacing: 0 !important;
  }
  .legacy-contribute .hero-copy p,
  .legacy-contribute .feature-copy p {
    font-size: var(--type-body) !important;
    line-height: 1.5 !important;
  }
  .legacy-contribute .button {
    font-size: var(--type-cta) !important;
    font-family: var(--font-open-sans);
  }
  .legacy-contribute .legacy-form input:not([type='hidden']),
  .legacy-contribute .legacy-form textarea {
    font-size: var(--type-input);
  }
  @media (max-width: 767px) {
    .legacy-contribute .hero-copy h1,
    .legacy-contribute .feature-copy h2,
    .legacy-contribute .form-copy h2 {
      font-size: var(--type-section) !important;
    }
    .legacy-contribute .hero-copy p,
    .legacy-contribute .feature-copy p {
      font-size: var(--type-body) !important;
    }
  }
  @media (max-width: 575px) {
    .legacy-contribute .hero-copy h1,
    .legacy-contribute .feature-copy h2,
    .legacy-contribute .form-copy h2 {
      font-size: var(--type-section) !important;
    }
  }
</style>


<style>
  /* Contributor sections: clear contrast and a simple mark beneath the form title. */
  .legacy-contribute .feature-white .feature-copy h2 { color: var(--color-brand); }
  .legacy-contribute .feature-white .feature-copy p { color: var(--color-brand); }
  .legacy-contribute .feature-blogging { background-image: linear-gradient(120deg, rgba(94,97,214,.58), rgba(95,66,197,.48) 52%, rgba(106,119,255,.42)), url('https://raw.githubusercontent.com/srvplt/fullfill/main/images/is-blogging-still-relevant.jpg'); }
  .legacy-contribute .feature-blogging .feature-copy-light h2 { color: #fff; }
  .legacy-contribute .feature-clients .feature-copy h2 { color: #3d4268; }
  .legacy-contribute .contribute-title-icon {
    display: block;
    width: 48px;
    height: 48px;
    object-fit: contain;
    margin: -10px auto 24px;
  }
  @media (min-width: 768px) {
    .legacy-contribute .contribute-title-icon { margin-left: 0; margin-right: 0; }
  }
</style>

<style>
  /* White contribution title with a larger icon directly beneath it. */
  .legacy-contribute .form-copy h2 { color: #fff !important; }
  .legacy-contribute .contribute-title-icon { width: 76px; height: 76px; margin: -2px auto 24px; }
  @media (min-width: 768px) { .legacy-contribute .contribute-title-icon { width: 88px; height: 88px; margin-left: 0; margin-right: 0; } }
</style>


<style>
  /* Reach New Clients: match the Happiness Compounds brand colour for title and body copy. */
  .legacy-contribute .feature-clients .feature-copy h2,
  .legacy-contribute .feature-clients .feature-copy p {
    color: var(--color-brand) !important;
  }
</style>


<style>
  /* Keep browser autofill from replacing the transparent contributor form fields
     with the browser's default white background and dark text. */
  .legacy-contribute .legacy-form input:not([type='hidden']):autofill,
  .legacy-contribute .legacy-form textarea:autofill,
  .legacy-contribute .legacy-form input:not([type='hidden']):-webkit-autofill,
  .legacy-contribute .legacy-form textarea:-webkit-autofill,
  .legacy-contribute .legacy-form input:not([type='hidden']):-webkit-autofill:hover,
  .legacy-contribute .legacy-form input:not([type='hidden']):-webkit-autofill:focus,
  .legacy-contribute .legacy-form textarea:-webkit-autofill:hover,
  .legacy-contribute .legacy-form textarea:-webkit-autofill:focus {
    -webkit-text-fill-color: #fff !important;
    caret-color: #fff;
    background-color: transparent !important;
    border-bottom-color: rgba(255,255,255,.75) !important;
    box-shadow: 0 0 0 1000px transparent inset !important;
    transition: background-color 99999s ease-out 0s;
  }
  .legacy-contribute .legacy-form input:not([type='hidden']):focus,
  .legacy-contribute .legacy-form textarea:focus {
    color: #fff;
  }
</style>



<style>
  /* Stronger scroll reveals: closer to the landing page's 60px / 800ms motion. */
  @media (prefers-reduced-motion: no-preference) {
    html.page-motion-ready .page-motion-reveal {
      transition: opacity 900ms cubic-bezier(.19,1,.22,1), transform 900ms cubic-bezier(.19,1,.22,1);
      transition-delay: var(--motion-delay, 0ms);
      will-change: opacity, transform;
    }
    html.page-motion-ready .page-motion-reveal:not(.page-motion-visible) {
      opacity: 0;
      transform: translate3d(0, 60px, 0) scale(.97);
    }
    html.page-motion-ready .page-motion-reveal.page-motion-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
    html.page-motion-ready .page-motion-from-left:not(.page-motion-visible) {
      transform: translate3d(-72px, 0, 0) scale(.97);
    }
    html.page-motion-ready .page-motion-from-right:not(.page-motion-visible) {
      transform: translate3d(72px, 0, 0) scale(.97);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-motion-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  }
</style>
<script>
  (() => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion || !('IntersectionObserver' in window)) return;

    const root = document.documentElement;
    const page = document.querySelector('.legacy-contribute, .corporate-page');
    if (!page) return;

    const selectors = page.classList.contains('legacy-contribute')
      ? [
          ['.hero-phone', 'page-motion-from-left'],
          ['.hero-copy', 'page-motion-from-right'],
          ['.feature-white .feature-copy', ''],
          ['.feature-white .feature-art', 'page-motion-from-right'],
          ['.feature-blogging .feature-copy', 'page-motion-from-left'],
          ['.feature-clients .feature-copy', ''],
          ['.feature-clients .clients-art', 'page-motion-from-right'],
          ['.form-copy', ''],
          ['.form-art', 'page-motion-from-right']
        ]
      : [
          ['.corp-hero__art', 'page-motion-from-left'],
          ['.corp-hero__copy', 'page-motion-from-right'],
          ['.corp-pressure__copy', ''],
          ['.corp-pullquote', 'page-motion-from-right'],
          ['.corp-pressure__chips', ''],
          ['.corp-offer__copy', 'page-motion-from-left'],
          ['.corp-offer__card', 'page-motion-from-right'],
          ['.corp-section-heading', ''],
          ['.corp-benefit', ''],
          ['.corp-enroll__copy', 'page-motion-from-left'],
          ['.corp-enroll__form', 'page-motion-from-right']
        ];

    const targets = [];
    selectors.forEach(([selector, direction]) => {
      page.querySelectorAll(selector).forEach((el, index) => {
        if (el.dataset.pageMotionReady) return;
        el.dataset.pageMotionReady = 'true';
        el.classList.add('page-motion-reveal');
        if (direction) el.classList.add(direction);
        if (selector === '.corp-benefit') el.style.setProperty('--motion-delay', (index % 4) * 90 + 'ms');
        targets.push(el);
      });
    });

    if (!targets.length) return;
    root.classList.add('page-motion-ready');

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('page-motion-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -20px 0px' });

    targets.forEach(el => {
      observer.observe(el);
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.92 && rect.bottom > 0) {
        el.classList.add('page-motion-visible');
        observer.unobserve(el);
      }
    });
  })();
</script>
